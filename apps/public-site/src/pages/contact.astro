---
import Layout from "../layouts/Layout.astro";
import BilingualText from "../components/content/BilingualText.astro";
import { contactPageCopy } from "../data/copy/contact";
---

<Layout
  title={contactPageCopy.meta.title}
  description={contactPageCopy.meta.description}
  routeLabel={contactPageCopy.meta.routeLabel}
  routePurpose={contactPageCopy.meta.routePurpose}
  pageHeading={contactPageCopy.meta.pageHeading}
>
  <section class="contact-grid" aria-label="Contact overview">
    <article class="panel panel--primary">
      <p class="eyebrow"><BilingualText copy={contactPageCopy.hero.eyebrow} /></p>
      <h2><BilingualText copy={contactPageCopy.hero.title} /></h2>
      <p>
        <BilingualText copy={contactPageCopy.hero.body} />
      </p>
      <div class="cta-row">
        <a class="cta-link" href="#reach-out"><BilingualText copy={contactPageCopy.hero.ctaLabel} /></a>
        <a class="cta-link" href="/privacy"><BilingualText copy={contactPageCopy.hero.privacyLabel} /></a>
      </div>
    </article>

    <article class="panel">
      <p class="eyebrow"><BilingualText copy={contactPageCopy.fit.eyebrow} /></p>
      <ul class="signal-list">
        {contactPageCopy.fit.items.map((item) => <li><BilingualText copy={item} /></li>)}
      </ul>
    </article>
  </section>

  <section class="contact-grid" id="reach-out" aria-label="How to reach out">
    <article class="panel">
      <p class="eyebrow"><BilingualText copy={contactPageCopy.reachOut.eyebrow} /></p>
      <h2><BilingualText copy={contactPageCopy.reachOut.title} /></h2>
      <p>
        <BilingualText copy={contactPageCopy.reachOut.body} />
      </p>
      <p class="note">
        <BilingualText copy={contactPageCopy.reachOut.note} />
      </p>
    </article>

    <article class="panel panel--muted">
      <p class="eyebrow"><BilingualText copy={contactPageCopy.notices.eyebrow} /></p>
      <h2><BilingualText copy={contactPageCopy.notices.title} /></h2>
      <p>
        <BilingualText copy={contactPageCopy.notices.body} />
      </p>
      <div class="cta-row">
        <a class="cta-link" href="/privacy"><BilingualText copy={contactPageCopy.notices.privacyLabel} /></a>
        <a class="cta-link" href="/terms"><BilingualText copy={contactPageCopy.notices.termsLabel} /></a>
      </div>
    </article>
  </section>

  <section class="panel panel--note" aria-label="Phase 1 note">
    <h2><BilingualText copy={contactPageCopy.boundary.title} /></h2>
    <p>
      <BilingualText copy={contactPageCopy.boundary.body} />
    </p>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .panel {
    padding: 1.2rem;
    border-radius: 22px;
    background: rgba(255, 253, 248, 0.92);
    border: 1px solid rgba(30, 38, 48, 0.1);
  }

  .panel--primary {
    background:
      linear-gradient(135deg, rgba(13, 116, 100, 0.12), transparent 72%),
      rgba(255, 253, 248, 0.96);
  }

  .panel--muted,
  .panel--note {
    background: rgba(13, 116, 100, 0.08);
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #0d7464;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .panel h2 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.2;
  }

  .panel p,
  .signal-list {
    margin: 0;
    color: #5c6a79;
    line-height: 1.65;
  }

  .signal-list {
    padding-left: 1.2rem;
  }

  .signal-list li + li {
    margin-top: 0.45rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1rem;
  }

  .cta-link {
    color: #1e2630;
    text-decoration: none;
    font-weight: 700;
  }

  .cta-link:hover,
  .cta-link:focus-visible {
    color: #0d7464;
  }

  .note {
    margin-top: 0.85rem;
  }

  @media (min-width: 760px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
