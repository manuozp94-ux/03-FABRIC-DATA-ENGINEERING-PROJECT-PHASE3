{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dim_cost_context",
  "description": "Bounded public-safe cost context dimension for the financial analytics foundation.",
  "type": "array",
  "x-grain": "One row per bounded cost context used for effective-dated unit-cost history.",
  "items": {
    "$ref": "#/$defs/row"
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "cost_context_sk",
        "replenishment_posture_code",
        "supply_node_class",
        "valuation_method_code",
        "procurement_profile_code",
        "currency_code",
        "foundation_version",
        "publication_safety_flag"
      ],
      "additionalProperties": false,
      "properties": {
        "cost_context_sk": {
          "type": "string",
          "pattern": "^CCT_SK_[A-F0-9]{12}$"
        },
        "replenishment_posture_code": {
          "type": "string",
          "enum": [
            "REPLENISH_CONTROLLED",
            "REPLENISH_COORDINATED",
            "REPLENISH_DENSE",
            "REPLENISH_PALLET",
            "REPLENISH_STANDARD"
          ]
        },
        "supply_node_class": {
          "type": "string",
          "minLength": 1
        },
        "valuation_method_code": {
          "type": "string",
          "enum": [
            "STANDARD"
          ]
        },
        "procurement_profile_code": {
          "type": "string",
          "minLength": 1
        },
        "currency_code": {
          "type": "string",
          "enum": [
            "USD"
          ]
        },
        "foundation_version": {
          "type": "string",
          "minLength": 1
        },
        "publication_safety_flag": {
          "type": "string",
          "enum": [
            "publication_safe"
          ]
        },
        "load_timestamp_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
