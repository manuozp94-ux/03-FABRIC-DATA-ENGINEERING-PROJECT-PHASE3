{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fact_inventory_snapshot",
  "description": "Publication-safe inventory snapshot fact for the bounded MVP slice.",
  "type": "array",
  "x-grain": "One row per product-location snapshot.",
  "x-date_semantics": {
    "snapshot_date": "Point-in-time inventory state date for the public product-location record."
  },
  "items": {
    "$ref": "#/$defs/row"
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "inventory_snapshot_sk",
        "product_sk",
        "inventory_location_sk",
        "snapshot_date",
        "on_hand_qty",
        "available_qty",
        "inventory_status_code",
        "record_source_family",
        "source_file_version",
        "publication_safety_flag"
      ],
      "additionalProperties": false,
      "properties": {
        "inventory_snapshot_sk": {
          "type": "string",
          "pattern": "^INV_SK_[A-F0-9]{12}$"
        },
        "product_sk": {
          "type": "string",
          "pattern": "^PRD_SK_[A-F0-9]{12}$"
        },
        "inventory_location_sk": {
          "type": "string",
          "pattern": "^LOC_SK_[A-F0-9]{12}$"
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "on_hand_qty": {
          "type": "integer",
          "minimum": 0
        },
        "available_qty": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_qty": {
          "type": "integer",
          "minimum": 0
        },
        "in_transit_qty": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_status_code": {
          "type": "string",
          "enum": [
            "READY",
            "AT_RISK",
            "IN_TRANSIT",
            "RESTRICTED",
            "UNKNOWN"
          ]
        },
        "inventory_value_proxy": {
          "type": "integer",
          "minimum": 0
        },
        "node_value_concentration_band": {
          "type": "string",
          "enum": [
            "NODE_LOW",
            "NODE_MEDIUM",
            "NODE_HIGH",
            "NODE_UNKNOWN"
          ]
        },
        "readiness_flag": {
          "type": "string",
          "enum": [
            "READY",
            "AT_RISK",
            "NOT_READY",
            "UNKNOWN"
          ]
        },
        "record_source_family": {
          "type": "string",
          "enum": [
            "inventory_position_domain"
          ]
        },
        "source_file_version": {
          "type": "string",
          "minLength": 1
        },
        "record_status": {
          "type": "string",
          "enum": [
            "active",
            "unknown"
          ]
        },
        "publication_safety_flag": {
          "type": "string",
          "enum": [
            "publication_safe"
          ]
        },
        "load_timestamp_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
