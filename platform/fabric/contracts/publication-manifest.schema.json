{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric-platform-dev-bmad.local/contracts/publication-manifest.schema.json",
  "title": "Publication Manifest",
  "description": "Versioned manifest contract for approved and candidate publication packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_kind",
    "publication_contract_version",
    "generated_at_utc",
    "source_boundary",
    "output_boundary",
    "artifacts",
    "validation_baseline",
    "test_tool_baseline"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^v[0-9]+$",
      "description": "Version of the manifest shape itself."
    },
    "package_kind": {
      "type": "string",
      "enum": ["approved_current", "candidate"],
      "description": "Publication lane represented by this manifest."
    },
    "publication_contract_version": {
      "type": "string",
      "pattern": "^v[0-9]+$",
      "description": "Version of the governed publication contract bundle."
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp for manifest generation."
    },
    "source_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_zone", "path"],
      "properties": {
        "logical_zone": {
          "type": "string",
          "enum": ["platform_fabric_current", "fabric_candidate"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sync_contract_ref"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sync_contract_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_name",
          "artifact_type",
          "schema_ref",
          "sync_eligible"
        ],
        "properties": {
          "artifact_name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.json$"
          },
          "artifact_type": {
            "type": "string",
            "enum": ["dimension", "fact", "manifest", "diagnostic_report"]
          },
          "schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "sync_eligible": {
            "type": "boolean"
          },
          "required_fields_ref": {
            "type": "string"
          }
        }
      }
    },
    "validation_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "preview", "ci"],
      "properties": {
        "local": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "preview": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "ci": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "test_tool_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_package", "public_site"],
      "properties": {
        "publication_package": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "public_site": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
