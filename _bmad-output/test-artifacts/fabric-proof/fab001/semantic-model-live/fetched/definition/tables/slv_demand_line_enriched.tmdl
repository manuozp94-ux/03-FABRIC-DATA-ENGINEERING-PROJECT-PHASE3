	measure 'Open Demand Qty' = CALCULATE(SUM('slv_demand_line_enriched'[open_qty]))
		formatString: #,0
		lineageTag: ef54aba3-11df-4a04-b0b7-0b32a19c8701

	measure 'Open Demand Lines' = CALCULATE(COUNTROWS('slv_demand_line_enriched'), 'slv_demand_line_enriched'[is_open] = TRUE())
		formatString: #,0
		lineageTag: db018419-493f-4604-ba6e-145b53e97372

	measure 'Open Demand Value Proxy' = CALCULATE(SUM('slv_demand_line_enriched'[demand_value_proxy]), 'slv_demand_line_enriched'[is_open] = TRUE())
