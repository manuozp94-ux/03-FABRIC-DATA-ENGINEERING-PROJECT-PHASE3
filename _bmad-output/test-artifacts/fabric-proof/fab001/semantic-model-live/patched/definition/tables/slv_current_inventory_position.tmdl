table slv_current_inventory_position
	lineageTag: 0b4f641d-c7f5-4340-bcc5-b27fb636684b
	sourceLineageTag: [dbo].[slv_current_inventory_position]

	measure 'Available Qty' = SUM('slv_current_inventory_position'[available_qty])
		formatString: #,0
		lineageTag: b31ce94f-f49f-44b2-bf23-a95eb3f3546a

	measure 'Ready Positions' = CALCULATE(COUNTROWS('slv_current_inventory_position'), 'slv_current_inventory_position'[readiness_flag] = "READY")
		formatString: #,0
		lineageTag: 08bf351d-5c97-4f84-a7d8-11621cfb1bfd

	measure 'Current Positions' = COUNTROWS('slv_current_inventory_position')
		formatString: #,0
		lineageTag: e65bfa99-df8f-421e-933f-536b1dfc5d8b

	measure 'Service Readiness Rate' = DIVIDE([Ready Positions], [Current Positions])
		formatString: 0.0%
		lineageTag: 7e87f393-486d-4972-9b05-93d7fab11cf8

	measure 'Inventory Exposure' = SUM('slv_current_inventory_position'[inventory_value_proxy])
		formatString: $#,0
		lineageTag: 6edcba13-d3ca-4ceb-a129-68953a1ebe6e

	measure 'Open-Demand Coverage' = DIVIDE([Available Qty], [Open Demand Qty])
		formatString: 0.0%
		lineageTag: d3995424-881e-4638-8efa-e51eedc7c914

	measure 'Active Action Count' = CALCULATE(COUNTROWS('slv_current_inventory_position'), 'slv_current_inventory_position'[action_status] <> "HOLD")
		formatString: #,0
		lineageTag: df7f4e35-bfd5-47f5-b733-d93f56926fb0

	measure 'Latest Approved Refresh' = MAX('slv_current_inventory_position'[load_timestamp_utc])
		formatString: yyyy-mm-dd hh:mm
		lineageTag: ebcf57de-b5a1-4468-9a46-4d075f0def00

