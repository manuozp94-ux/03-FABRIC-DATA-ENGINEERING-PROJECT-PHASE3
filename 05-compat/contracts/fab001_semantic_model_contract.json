  "measures": [
    {
      "name": "Open Demand Qty",
      "table": "slv_demand_line_enriched",
      "expression": "CALCULATE(SUM('slv_demand_line_enriched'[open_qty]))",
      "format_string": "#,0"
    },
    {
      "name": "Open Demand Lines",
      "table": "slv_demand_line_enriched",
      "expression": "CALCULATE(COUNTROWS('slv_demand_line_enriched'), 'slv_demand_line_enriched'[is_open] = TRUE())",
      "format_string": "#,0"
    },
    {
      "name": "Open Demand Value Proxy",
      "table": "slv_demand_line_enriched",
      "expression": "CALCULATE(SUM('slv_demand_line_enriched'[demand_value_proxy]), 'slv_demand_line_enriched'[is_open] = TRUE())",
      "format_string": "$#,0"
    },
    {
      "name": "Demand Value Proxy",
      "table": "slv_demand_line_enriched",
      "expression": "SUM('slv_demand_line_enriched'[demand_value_proxy])",
      "format_string": "$#,0"
    },
    {
      "name": "Available Qty",
      "table": "slv_current_inventory_position",
      "expression": "SUM('slv_current_inventory_position'[available_qty])",
      "format_string": "#,0"
    },
    {
      "name": "On Hand Qty",
      "table": "slv_current_inventory_position",
      "expression": "SUM('slv_current_inventory_position'[on_hand_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Reserved Qty",
      "table": "slv_current_inventory_position",
      "expression": "SUM('slv_current_inventory_position'[reserved_qty])",
      "format_string": "#,0"
    },
    {
      "name": "In Transit Qty",
      "table": "slv_current_inventory_position",
      "expression": "SUM('slv_current_inventory_position'[in_transit_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Ready Positions",
      "table": "slv_current_inventory_position",
      "expression": "CALCULATE(COUNTROWS('slv_current_inventory_position'), 'slv_current_inventory_position'[readiness_flag] = \"READY\")",
      "format_string": "#,0"
    },
    {
      "name": "Current Positions",
      "table": "slv_current_inventory_position",
      "expression": "COUNTROWS('slv_current_inventory_position')",
      "format_string": "#,0"
    },
    {
      "name": "Service Readiness Rate",
      "table": "slv_current_inventory_position",
      "expression": "DIVIDE([Ready Positions], [Current Positions])",
      "format_string": "0.0%"
    },
    {
      "name": "Inventory Exposure",
      "table": "slv_current_inventory_position",
      "expression": "SUM('slv_current_inventory_position'[inventory_value_proxy])",
      "format_string": "$#,0"
    },
    {
      "name": "Open-Demand Coverage",
      "table": "slv_current_inventory_position",
      "expression": "DIVIDE([Available Qty], [Open Demand Qty])",
      "format_string": "0.0%"
    },
    {
      "name": "Active Action Count",
      "table": "slv_current_inventory_position",
      "expression": "CALCULATE(COUNTROWS('slv_current_inventory_position'), 'slv_current_inventory_position'[action_status] <> \"HOLD\")",
      "format_string": "#,0"
    },
    {
      "name": "Latest Approved Refresh",
      "table": "slv_current_inventory_position",
      "expression": "MAX('slv_current_inventory_position'[load_timestamp_utc])",
      "format_string": "yyyy-mm-dd hh:mm"
    },
    {
      "name": "Realized Revenue",
      "table": "fact_sales_realization",
      "expression": "SUM('fact_sales_realization'[net_revenue_amount])",
      "format_string": "$#,0"
    },
    {
      "name": "Realized COGS",
      "table": "fact_sales_realization",
      "expression": "SUM('fact_sales_realization'[cogs_amount])",
      "format_string": "$#,0"
    },
    {
      "name": "Realized Gross Margin",
      "table": "fact_sales_realization",
      "expression": "SUM('fact_sales_realization'[gross_margin_amount])",
      "format_string": "$#,0"
    },
    {
      "name": "Realized Margin Rate",
      "table": "fact_sales_realization",
      "expression": "DIVIDE([Realized Gross Margin], [Realized Revenue])",
      "format_string": "0.0%"
    },
    {
      "name": "Fulfilled Qty",
      "table": "fact_sales_realization",
      "expression": "SUM('fact_sales_realization'[fulfilled_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Average Revenue per Account",
      "table": "fact_sales_realization",
      "expression": "DIVIDE([Realized Revenue], DISTINCTCOUNT('fact_sales_realization'[account_sk]))",
      "format_string": "$#,0"
    },
    {
      "name": "Backordered Qty",
      "table": "fact_sales_fulfillment_line",
      "expression": "SUM('fact_sales_fulfillment_line'[backordered_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Fulfillment Line Count",
      "table": "fact_sales_fulfillment_line",
      "expression": "COUNTROWS('fact_sales_fulfillment_line')",
      "format_string": "#,0"
    },
    {
      "name": "SC Recommended Qty",
      "table": "fact_supply_chain_decision_queue_line",
      "expression": "SUM('fact_supply_chain_decision_queue_line'[recommended_qty])",
      "format_string": "#,0"
    },
    {
      "name": "SC Approved Qty",
      "table": "fact_supply_chain_decision_queue_line",
      "expression": "SUM('fact_supply_chain_decision_queue_line'[approved_qty])",
      "format_string": "#,0"
    },
    {
      "name": "SC Decision Cost Amount",
      "table": "fact_supply_chain_decision_queue_line",
      "expression": "SUM('fact_supply_chain_decision_queue_line'[cost_amount_usd])",
      "format_string": "$#,0"
    },
    {
      "name": "Approved SC Decisions",
      "table": "fact_supply_chain_decision_queue_line",
      "expression": "CALCULATE(DISTINCTCOUNT('fact_supply_chain_decision_queue_line'[supply_chain_decision_line_sk]), 'fact_supply_chain_decision_queue_line'[recommendation_status_code] = \"APPROVED\")",
      "format_string": "#,0"
    },
    {
      "name": "Purchase Ordered Qty",
      "table": "fact_purchase_order_line",
      "expression": "SUM('fact_purchase_order_line'[ordered_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Purchase Received Qty",
      "table": "fact_purchase_order_line",
      "expression": "SUM('fact_purchase_order_line'[received_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Open Purchase Qty",
      "table": "fact_purchase_order_line",
      "expression": "SUM('fact_purchase_order_line'[open_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Purchase Cost Amount",
      "table": "fact_purchase_order_line",
      "expression": "SUM('fact_purchase_order_line'[purchase_cost_amount_usd])",
      "format_string": "$#,0"
    },
    {
      "name": "Purchase Order Lines",
      "table": "fact_purchase_order_line",
      "expression": "COUNTROWS('fact_purchase_order_line')",
      "format_string": "#,0"
    },
    {
      "name": "Executed Purchase Decisions",
      "table": "fact_purchase_order_line",
      "expression": "DISTINCTCOUNT('fact_purchase_order_line'[supply_chain_decision_line_sk])",
      "format_string": "#,0"
    },
    {
      "name": "Queue-to-PO Traceability Rate",
      "table": "fact_purchase_order_line",
      "expression": "DIVIDE([Executed Purchase Decisions], [Approved SC Decisions])",
      "format_string": "0.0%"
    },
    {
      "name": "Logistics Recommended Qty",
      "table": "fact_logistics_decision_queue_line",
      "expression": "SUM('fact_logistics_decision_queue_line'[recommended_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Logistics Approved Qty",
      "table": "fact_logistics_decision_queue_line",
      "expression": "SUM('fact_logistics_decision_queue_line'[approved_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Active Logistics Action Count",
      "table": "fact_logistics_decision_queue_line",
      "expression": "COUNTROWS('fact_logistics_decision_queue_line')",
      "format_string": "#,0"
    },
    {
      "name": "Movement Qty",
      "table": "fact_inventory_movement_line",
      "expression": "SUM('fact_inventory_movement_line'[movement_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Movement In Transit Qty",
      "table": "fact_inventory_movement_line",
      "expression": "SUM('fact_inventory_movement_line'[in_transit_qty])",
      "format_string": "#,0"
    },
    {
      "name": "Movement Cost Amount",
      "table": "fact_inventory_movement_line",
      "expression": "SUM('fact_inventory_movement_line'[movement_cost_amount_usd])",
      "format_string": "$#,0"
    }
